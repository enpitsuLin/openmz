{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "env": { "browser": true, "node": true },
  "overrides": [
    {
      "files": ["packages/openmz/src/*.ts"],
      "rules": {
        "no-unused-vars": ["error", { "varsIgnorePattern": "^[A-Z]", "argsIgnorePattern": "^_" }]
      }
    },
    {
      "files": ["packages/openmz/src/rmmz_objects.ts"],
      "rules": { "no-eval": "off" }
    },
    {
      "files": ["packages/openmz/src/rmmz_windows.ts"],
      "rules": { "no-control-regex": "off" }
    },
    {
      "files": ["packages/openmz/src/rmmz_sprites.ts"],
      "rules": {
        "typescript/no-this-alias": ["error", { "allowedNames": ["sprite", "object"] }]
      }
    }
  ],
  "ignorePatterns": [
    "**/dist/**",
    "vendor/**",
    "packages/openmz/tests/plugin-compat/fixtures/**",
    "examples/hd2d/js/**",
    ".agents/**",
    ".codemod/**",
    ".planning/**"
  ]
}
