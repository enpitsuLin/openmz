{
  "name": "openmz",
  "version": "2.0.0-rc.0",
  "description": "RPG Maker MZ engine with ES6 class sources and a prototype-based runtime.",
  "main": "index.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:release": "node scripts/build-release.mjs",
    "build:types": "node scripts/build-dts.mjs",
    "check:types": "node scripts/build-dts.mjs --check",
    "serve:manifest": "node scripts/serve-manifest.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:plugin-compat": "vitest run --project plugin-compat"
  },
  "keywords": [],
  "author": "enpitsulin <enpitsulin@gmail.com>",
  "license": "MIT",
  "packageManager": "pnpm@12.23.0",
  "type": "module",
  "devDependencies": {
    "@ast-grep/napi": "^0.51.3",
    "@types/node": "^15.14.9",
    "@types/nw.js": "^0.13.21",
    "@vitest/browser-playwright": "^5.1.1",
    "pixi.js": "8.23.0",
    "playwright": "^1.65.1",
    "rolldown": "^1.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  }
}
