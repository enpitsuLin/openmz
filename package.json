{
  "name": "openmz",
  "version": "2.0.0-rc.0",
  "description": "RPG Maker MZ engine with ES6 class sources and a prototype-based runtime.",
  "main": "index.js",
  "scripts": {
    "build": "node scripts/build.ts",
    "build:runtime": "node scripts/build-runtime.ts",
    "build:plugins": "node scripts/build-plugins.ts",
    "build:release": "node scripts/build-release.ts",
    "serve:manifest": "node scripts/serve-manifest.ts",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix --deny-warnings",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:plugin-compat": "vitest run --project plugin-compat"
  },
  "keywords": [],
  "author": "enpitsulin <enpitsulin@gmail.com>",
  "license": "MIT",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "devDependencies": {
    "@ast-grep/napi": "^0.51.3",
    "@types/node": "^24.19.4",
    "@types/nw.js": "^0.13.21",
    "@vitest/browser-playwright": "^5.1.1",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "pixi.js": "8.23.0",
    "playwright": "^1.65.1",
    "rolldown": "^1.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  }
}
