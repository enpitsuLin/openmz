{
  "name": "openmz-workspace",
  "private": true,
  "description": "OpenMZ monorepo containing the core engine, internal build/release tools, and official plugins.",
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix --deny-warnings",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit && pnpm -r --if-present run typecheck",
    "test": "vitest run",
    "test:unit": "pnpm -r --if-present run test:unit"
  },
  "author": "enpitsulin <enpitsulin@gmail.com>",
  "license": "MIT",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/nw.js": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
