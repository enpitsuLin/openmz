{
  "compilerOptions": {
    "target": "es2021",
    "lib": [],
    "moduleDetection": "force",
    "module": "preserve",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "strict": true,
    "types": [
      "node",
      "nw.js",
      "./types/env.d.ts",
      "typescript/lib/lib.es2021",
      "typescript/lib/lib.dom",
      "typescript/lib/lib.dom.iterable",
      "typescript/lib/lib.dom.asynciterable"
    ],
    "noUnusedLocals": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": true,
    "noEmit": true
  },
  "include": [
    "src",
    "types",
    "tests/**/*.test.ts"
  ]
}
