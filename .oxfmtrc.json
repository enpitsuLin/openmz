{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "singleQuote": true,
  "sortPackageJson": false,
  "ignorePatterns": [
    "**/dist/**",
    "vendor/**",
    "packages/openmz/tests/plugin-compat/fixtures/**",
    "examples/hd2d/data/**",
    "examples/hd2d/css/game.css",
    "examples/hd2d/js/**",
    ".agents/**",
    ".codemod/**",
    ".planning/**",
    "pnpm-lock.yaml"
  ],
  "overrides": [
    {
      "files": ["packages/openmz/src/*.ts"],
      "options": { "tabWidth": 4, "singleQuote": false }
    }
  ]
}
